# Admin (server-only — not exposed to the browser)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Shankarayya@2026
AUTH_SECRET=generate-a-long-random-string

# SQLite via Turso (required on Vercel — local file DB does not persist on serverless)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local dev fallback when Turso is unset
# DATABASE_URL=file:./data/gallery.db

# Vercel Blob for image uploads in production (optional locally — saves to public/uploads/gallery)
BLOB_READ_WRITE_TOKEN=
